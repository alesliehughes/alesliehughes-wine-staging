Subject: [PATCH] mfps: MERGE - Implement
 IMFSourceResolver_BeginCreateObjectFromURL_Proxy

---
 dlls/mfps/main.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/dlls/mfps/main.c b/dlls/mfps/main.c
index a39ffeb5c6e..e8199c75ece 100644
--- a/dlls/mfps/main.c
+++ b/dlls/mfps/main.c
@@ -182,8 +182,15 @@ HRESULT CALLBACK IMFSourceResolver_BeginCreateObjectFromURL_Proxy(IMFSourceResol
                 const WCHAR *url, DWORD flags, IPropertyStore *props, IUnknown **cancel_cookie,
                 IMFAsyncCallback *callback, IUnknown *unk_state)
 {
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    HRESULT hr;
+
+    TRACE("(%p, %s, %lx, %p, %p, %p, %p)\n", This, debugstr_w(url),  flags, props, cancel_cookie,
+                callback, unk_state);
+
+    hr = IMFSourceResolver_RemoteBeginCreateObjectFromURL_Proxy(This, url,  flags, props, NULL /*callback*/);
+
+    TRACE("ret 0x%lx\n", hr);
+    return hr;
 }
 
 HRESULT CALLBACK IMFSourceResolver_EndCreateObjectFromURL_Proxy(IMFSourceResolver* This,
