From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Wed, 21 Oct 2026 12:49:27 +1100
Subject: [PATCH] mfps IMFSourceResolver_BeginCreateObjectFromURL_Stub - Merge

---
 dlls/mfps/main.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/dlls/mfps/main.c b/dlls/mfps/main.c
index 53f582e764e..1c52c4c88cd 100644
--- a/dlls/mfps/main.c
+++ b/dlls/mfps/main.c
@@ -325,11 +325,19 @@ HRESULT __RPC_STUB IMFTopologyNode_GetInputPrefType_Stub(IMFTopologyNode* This,
     return E_NOTIMPL;
 }
 
+
 HRESULT __RPC_STUB IMFSourceResolver_BeginCreateObjectFromURL_Stub(IMFSourceResolver* This,
                 const WCHAR *url, DWORD flags, IPropertyStore *props, IMFRemoteAsyncCallback *callback)
 {
-    FIXME("(%p)\n", This);
-    return E_NOTIMPL;
+    HRESULT hr;
+    struct remote_callback *remote = impl_from_IMFRemoteAsyncCallback(callback);
+
+    FIXME("(%p, %s, 0x%lx, %p, %p)\n", This, debugstr_w(url), flags, props, callback);
+
+    hr = IMFSourceResolver_BeginCreateObjectFromURL(This, url, flags, props, NULL, remote->ayncallback, NULL);
+
+    FIXME("ret %lx\n", hr);
+    return hr;
 }
 
 HRESULT __RPC_STUB IMFSourceResolver_EndCreateObjectFromURL_Stub(IMFSourceResolver* This,
