From e6a9b92778d43e0dd0c9413551e9b309763752f3 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Wed, 21 Oct 2026 10:55:59 +1100
Subject: [PATCH] propsys: Support marshalling of interfaces.

---
 dlls/propsys/Makefile.in       |  6 +++++-
 dlls/propsys/propsys_main.c    | 21 ++++++++++++++++++--
 dlls/propsys/propsys_store.idl | 30 +++++++++++++++++++++++++++++
 dlls/propsys/tests/Makefile.in |  2 +-
 dlls/propsys/tests/propsys.c   | 35 ++++++++++++++++++++++++++++++++--
 5 files changed, 88 insertions(+), 6 deletions(-)
 create mode 100644 dlls/propsys/propsys_store.idl

diff --git a/dlls/propsys/Makefile.in b/dlls/propsys/Makefile.in
index a8661ca17e9..78de05472ac 100644
--- a/dlls/propsys/Makefile.in
+++ b/dlls/propsys/Makefile.in
@@ -1,12 +1,16 @@
 EXTRADEFS = -D_PROPSYS_
 MODULE    = propsys.dll
 IMPORTLIB = propsys
-IMPORTS   = ole32 oleaut32 uuid
+IMPORTS   = ole32 oleaut32 uuid rpcrt4
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
 	propstore.c \
 	propsys_classes.idl \
+	propsys_store.idl \
 	propsys_main.c \
 	propvar.c
+
+dlldata_EXTRADEFS = -DENTRY_PREFIX=PROPSYS_ -DWINE_REGISTER_DLL -DPROXY_DELEGATION \
+		-DPROXY_CLSID_IS="{0xF562A2C8,0xE850,0x4F05,{0x8E,0x7A,0xE7,0x19,0x2E,0x4E,0x6C,0x23}}"
diff --git a/dlls/propsys/propsys_main.c b/dlls/propsys/propsys_main.c
index a39759c3577..49130be32c5 100644
--- a/dlls/propsys/propsys_main.c
+++ b/dlls/propsys/propsys_main.c
@@ -116,8 +116,12 @@ static const IClassFactoryVtbl PropertySystemFactoryVtbl =
 
 static IClassFactory PropertySystemFactory = { &PropertySystemFactoryVtbl };
 
+extern HRESULT WINAPI PROPSYS_DllGetClassObject(REFCLSID, REFIID, LPVOID *);
+
 HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, LPVOID *ppv)
 {
+    TRACE("%s %s %p\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
+
     if(IsEqualGUID(&CLSID_InMemoryPropertyStore, rclsid)) {
         TRACE("(CLSID_InMemoryPropertyStore %s %p)\n", debugstr_guid(riid), ppv);
         return IClassFactory_QueryInterface(&InMemoryPropertyStoreFactory, riid, ppv);
@@ -128,8 +132,7 @@ HRESULT WINAPI DllGetClassObject(REFCLSID rclsid, REFIID riid, LPVOID *ppv)
         return IClassFactory_QueryInterface(&PropertySystemFactory, riid, ppv);
     }
 
-    FIXME("%s %s %p\n", debugstr_guid(rclsid), debugstr_guid(riid), ppv);
-    return CLASS_E_CLASSNOTAVAILABLE;
+    return PROPSYS_DllGetClassObject(rclsid, riid, ppv);
 }
 
 static HRESULT WINAPI propsys_QueryInterface(IPropertySystem *iface, REFIID riid, void **obj)
@@ -914,3 +917,17 @@ static HRESULT propdesc_get_by_key( const PROPERTYKEY *key, IPropertyDescription
 
     return TYPE_E_ELEMENTNOTFOUND;
 }
+
+
+HRESULT CALLBACK IPropertyDescription_CoerceToCanonicalValue_Proxy(IPropertyDescription* This, PROPVARIANT *propvar)
+{
+    FIXME("%p, %p\n", This, propvar);
+    return E_NOTIMPL;
+}
+
+HRESULT __RPC_STUB IPropertyDescription_CoerceToCanonicalValue_Stub( IPropertyDescription* This,
+                REFPROPVARIANT propvar, PROPVARIANT *ppropvar)
+{
+    FIXME("%p, %p, %p\n", This, propvar, ppropvar);
+    return E_NOTIMPL;
+}
