+
+/* just a wrapper for propsys.idl */
+
+#pragma makedep proxy
+#pragma makedep register
+
+#include "propsys.idl"
+
+[
+    threading(both),
+    uuid(F562A2C8-E850-4F05-8E7A-E7192E4E6C23)
+]
+coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
