From 23dc5fb3ceee925ebf63e16e3205be6677f778b0 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Tue, 10 Nov 2026 19:49:49 +1100
Subject: [PATCH] IUIFramework::SetModes trace iModes as a hex value.

This is a reported as a flag, so displaying it as hex make sense.
---
 dlls/uiribbon/uiribbon.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/uiribbon/uiribbon.c b/dlls/uiribbon/uiribbon.c
index 7a1363153ab..ab0fc013d7f 100644
--- a/dlls/uiribbon/uiribbon.c
+++ b/dlls/uiribbon/uiribbon.c
@@ -159,7 +159,7 @@ static HRESULT WINAPI UIRibbonFrameworkImpl_FlushPendingInvalidations(IUIFramewo
 
 static HRESULT WINAPI UIRibbonFrameworkImpl_SetModes(IUIFramework *iface, INT32 iModes)
 {
-    FIXME("(%d): stub!\n", iModes);
+    FIXME("(0x%x): stub!\n", iModes);
 
     return E_NOTIMPL;
 }
