From 44330a6e344429783dceac680984a4a9145d7135 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Tue, 13 Oct 2026 10:16:17 +1100
Subject: [PATCH] dxgi: Resource Add IDXGIKeyedMutex interface

---
 dlls/dxgi/dxgi_private.h |   1 +
 dlls/dxgi/resource.c     | 109 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 110 insertions(+)

diff --git a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
index 6ecd5751243..531413d0c6d 100644
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -203,6 +203,7 @@ struct dxgi_resource
 {
     IDXGISurface2 IDXGISurface2_iface;
     IDXGIResource1 IDXGIResource1_iface;
+    IDXGIKeyedMutex IDXGIKeyedMutex_iface;
     IUnknown IUnknown_iface;
     IUnknown *outer_unknown;
     LONG refcount;
diff --git a/dlls/dxgi/resource.c b/dlls/dxgi/resource.c
index 5638a8b7e33..8ae6350c037 100644
--- a/dlls/dxgi/resource.c
+++ b/dlls/dxgi/resource.c
@@ -53,6 +53,12 @@ static HRESULT STDMETHODCALLTYPE dxgi_resource_inner_QueryInterface(IUnknown *if
         *out = &resource->IDXGIResource1_iface;
         return S_OK;
     }
+    else if (IsEqualGUID(riid, &IID_IDXGIKeyedMutex))
+    {
+        IDXGIKeyedMutex_AddRef(&resource->IDXGIKeyedMutex_iface);
+        *out = &resource->IDXGIKeyedMutex_iface;
+        return S_OK;
+    }
 
     WARN("%s not implemented, returning E_NOINTERFACE\n", debugstr_guid(riid));
 
@@ -515,6 +521,108 @@ static const struct IUnknownVtbl dxgi_resource_inner_unknown_vtbl =
     dxgi_resource_inner_Release,
 };
 
+
+static inline struct dxgi_resource *impl_from_IDXGIKeyedMutex(IDXGIKeyedMutex *iface)
+{
+    return CONTAINING_RECORD(iface, struct dxgi_resource, IDXGIKeyedMutex_iface);
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_QueryInterface(IDXGIKeyedMutex *iface, REFIID riid, void **out)
+{
+    struct dxgi_resource *resource = impl_from_IDXGIKeyedMutex(iface);
+
+    if ((IsEqualGUID(riid, &IID_IUnknown)
+           || IsEqualGUID(riid, &IID_IDXGIObject)
+           || IsEqualGUID(riid, &IID_IDXGIDeviceSubObject)
+           || IsEqualGUID(riid, &IID_IDXGIKeyedMutex)))
+    {
+        IDXGIKeyedMutex_AddRef(&resource->IDXGIKeyedMutex_iface);
+        *out = &resource->IDXGIKeyedMutex_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE\n", debugstr_guid(riid));
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI dxgi_keyed_mutex_AddRef(IDXGIKeyedMutex *iface)
+{
+    struct dxgi_resource *resource = impl_from_IDXGIKeyedMutex(iface);
+    return IDXGIResource1_AddRef(&resource->IDXGIResource1_iface);
+}
+
+static ULONG WINAPI dxgi_keyed_mutex_Release(IDXGIKeyedMutex *iface)
+{
+    struct dxgi_resource *resource = impl_from_IDXGIKeyedMutex(iface);
+    return IDXGIResource1_Release(&resource->IDXGIResource1_iface);
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_SetPrivateData(IDXGIKeyedMutex *iface, REFGUID guid, UINT data_size, const void *data)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_SetPrivateDataInterface(IDXGIKeyedMutex *iface, REFGUID guid, const IUnknown *object)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_GetPrivateData(IDXGIKeyedMutex *iface, REFGUID guid, UINT *data_size, void *data)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_GetParent(IDXGIKeyedMutex *iface, REFIID riid, void **parent)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_GetDevice(IDXGIKeyedMutex *iface, REFIID riid, void **device)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface, UINT64 Key, DWORD dwMilliseconds)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI dxgi_keyed_mutex_ReleaseSync(IDXGIKeyedMutex *iface, UINT64 Key)
+{
+    FIXME("iface %p stub!\n", iface);
+
+    return S_OK;
+}
+
+
+struct IDXGIKeyedMutexVtbl dxgi_keyed_mutex_vtbl =
+{
+    dxgi_keyed_mutex_QueryInterface,
+    dxgi_keyed_mutex_AddRef,
+    dxgi_keyed_mutex_Release,
+    dxgi_keyed_mutex_SetPrivateData,
+    dxgi_keyed_mutex_SetPrivateDataInterface,
+    dxgi_keyed_mutex_GetPrivateData,
+    dxgi_keyed_mutex_GetParent,
+    dxgi_keyed_mutex_GetDevice,
+    dxgi_keyed_mutex_AcquireSync,
+    dxgi_keyed_mutex_ReleaseSync
+};
+
 HRESULT dxgi_resource_init(struct dxgi_resource *resource, IDXGIDevice *device,
         IUnknown *outer, BOOL needs_surface, struct wined3d_resource *wined3d_resource,
         IDXGIResource1 *parent_resource, unsigned int subresource_index)
@@ -533,6 +641,7 @@ HRESULT dxgi_resource_init(struct dxgi_resource *resource, IDXGIDevice *device,
         resource->IDXGISurface2_iface.lpVtbl = NULL;
     resource->IDXGIResource1_iface.lpVtbl = &dxgi_resource_vtbl;
     resource->IUnknown_iface.lpVtbl = &dxgi_resource_inner_unknown_vtbl;
+    resource->IDXGIKeyedMutex_iface .lpVtbl = &dxgi_keyed_mutex_vtbl;
     resource->refcount = 1;
     wined3d_private_store_init(&resource->private_store);
     resource->outer_unknown = outer ? outer : &resource->IUnknown_iface;
-- 
2.53.0

