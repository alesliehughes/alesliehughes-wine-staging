+static void test_PSGetItemPropertyHandler(void)
+{
+    IShellItem2 outer = { &ShellItem2_Vtbl };
+    HRESULT hr;
+    IPropertyStore *store;
+
+    store_flags = 0;
+    hr = PSGetItemPropertyHandler( (IUnknown*)&outer, FALSE, &IID_IUnknown, (void**)&store);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    ok(store_flags == GPS_HANDLERPROPERTIESONLY, "got %08lx\n", store_flags);
+
+    store_flags = 0;
+    hr = PSGetItemPropertyHandler( (IUnknown*)&outer, FALSE, &IID_IShellItem2, (void**)&store);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    ok(store_flags == GPS_HANDLERPROPERTIESONLY, "got %08lx\n", store_flags);
+
+    store_flags = 0;
+    hr = PSGetItemPropertyHandler( (IUnknown*)&outer, FALSE, &IID_IPropertyStore, (void**)&store);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    ok(store_flags == GPS_HANDLERPROPERTIESONLY, "got %08lx\n", store_flags);
+
+    store_flags = 0;
+    hr = PSGetItemPropertyHandler( (IUnknown*)&outer, TRUE, &IID_IPropertyStore, (void**)&store);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+    ok(store_flags == (GPS_HANDLERPROPERTIESONLY | GPS_READWRITE), "got %08lx\n", store_flags);
+}
