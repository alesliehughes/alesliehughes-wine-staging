+
+HRESULT WINAPI PSGetItemPropertyHandler(IUnknown *obj, BOOL readwrite, REFIID riid, void **ret)
+{
+    HRESULT hr;
+    IShellItem2 *shellitem2;
+    DWORD flags = GPS_HANDLERPROPERTIESONLY;
+
+    TRACE("(%p, %d, %s, %p)\n", obj, readwrite, debugstr_guid(riid), ret);
+
+    if (!obj || !ret)
+        return E_POINTER;
+
+    hr = IUnknown_QueryInterface(obj, &IID_IShellItem2, ((void**)&shellitem2));
+    if (SUCCEEDED(hr))
+    {
+        if (readwrite)
+            flags |= GPS_READWRITE;
+        hr = IShellItem2_GetPropertyStore(shellitem2, flags, riid, ret);
+        IUnknown_Release(shellitem2);
+    }
+    else
+        FIXME("Unsupported interface %s.\n", debugstr_guid(riid));
+
+    return hr;
+}
