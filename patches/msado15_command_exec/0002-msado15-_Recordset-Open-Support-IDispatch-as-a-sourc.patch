From f828d770910096174d16e6b3ec97d38f3e82e653 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Tue, 22 Sep 2026 11:46:23 +1000
Subject: [PATCH] msado15: _Recordset::Open Support IDispatch as a source

---
 dlls/msado15/recordset.c | 38 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 36 insertions(+), 2 deletions(-)

diff --git a/dlls/msado15/recordset.c b/dlls/msado15/recordset.c
index b9d51baab99..a7d018d4211 100644
--- a/dlls/msado15/recordset.c
+++ b/dlls/msado15/recordset.c
@@ -2753,6 +2753,8 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
     struct recordset *recordset = impl_from_Recordset( iface );
     ADOConnectionConstruction15 *construct;
     IUnknown *session, *rowset, *rowsetex;
+    _Command *user_command = NULL;
+    BSTR bstr_command;
     HRESULT hr;
 
     TRACE( "%p, %s, %s, %d, %d, %ld\n", recordset, debugstr_variant(&source), debugstr_variant(&active_connection),
@@ -2760,6 +2762,31 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
 
     if (recordset->state == adStateOpen) return MAKE_ADO_HRESULT( adErrObjectOpen );
 
+    if (V_VT(&source) == VT_DISPATCH)
+    {
+        _Connection *conn;
+
+        hr = IDispatch_QueryInterface(V_DISPATCH(&source), &IID__Command, (void**)&user_command);
+        if (FAILED(hr))
+           return hr;
+
+        V_VT(&active_connection) = VT_DISPATCH;
+        hr = _Command_get_ActiveConnection(user_command, &conn);
+        if (FAILED(hr))
+        {
+            _Command_Release(user_command);
+            return MAKE_ADO_HRESULT( adErrInvalidConnection );
+        }
+
+        hr = _Connection_QueryInterface(conn, &IID_IDispatch, (void**)&V_DISPATCH(&active_connection));
+        if (FAILED(hr))
+        {
+            _Command_Release(user_command);
+            return MAKE_ADO_HRESULT( adErrInvalidConnection );
+        }
+    }
+
+
     if (V_VT(&active_connection) != VT_ERROR || V_ERROR(&active_connection) != DISP_E_PARAMNOTFOUND)
     {
         hr = _Recordset_put_ActiveConnection( iface, active_connection );
@@ -2824,11 +2851,17 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
     if (!recordset->active_connection)
         return MAKE_ADO_HRESULT( adErrInvalidConnection );
 
-    if (V_VT(&source) != VT_BSTR)
+    if (V_VT(&source) == VT_DISPATCH)
+    {
+        hr = _Command_get_CommandText(user_command, &bstr_command);
+    }
+    else if (V_VT(&source) != VT_BSTR)
     {
         FIXME("Unsupported source type!\n");
         return E_FAIL;
     }
+    else
+        bstr_command = SysAllocString(V_BSTR(&source));
 
     hr = _Connection_QueryInterface(recordset->active_connection, &IID_ADOConnectionConstruction15, (void**)&construct);
     if (FAILED(hr))
@@ -2839,7 +2872,8 @@ static HRESULT WINAPI recordset_Open( _Recordset *iface, VARIANT source, VARIANT
     if (FAILED(hr))
         return E_FAIL;
 
-    hr = get_rowset(recordset, session, V_BSTR(&source), &rowset);
+    hr = get_rowset(recordset, session, bstr_command, &rowset);
+    SysFreeString(bstr_command);
     IUnknown_Release(session);
     if (FAILED(hr) || !rowset)
         return hr;
-- 
2.53.0

