From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Mon, 19 Oct 2026 08:53:19 +1100
Subject: [PATCH 86/86] rtworkq: RtwqAddPeriodicCallback dont assign output on
 failure

---
 dlls/rtworkq/queue.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index 2dd84235e83..81ec6df45bd 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -1486,8 +1486,9 @@ HRESULT WINAPI RtwqAddPeriodicCallback(RTWQPERIODICCALLBACK callback, IUnknown *
 
     /* Same period MFGetTimerPeriodicity() returns. */
     hr = queue_submit_timer(queue, result, 0, 10, key ? &workitem_key : NULL);
-
     IRtwqAsyncResult_Release(result);
+    if (FAILED(hr))
+        return hr;
 
     if (key)
         *key = workitem_key;
