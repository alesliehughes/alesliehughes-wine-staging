From b7fd89a41f82e2facc7005563fbb78daea33d993 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 12 Nov 2026 10:32:26 +1100
Subject: [PATCH 1/2] odbccp32: Stop possible overflow for UsageCount

---
 dlls/odbccp32/odbccp32.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/odbccp32/odbccp32.c b/dlls/odbccp32/odbccp32.c
index 20ae49d0db2..b60318ab80b 100644
--- a/dlls/odbccp32/odbccp32.c
+++ b/dlls/odbccp32/odbccp32.c
@@ -2112,7 +2112,7 @@ BOOL WINAPI SQLRemoveDriverW(LPCWSTR drivername, BOOL remove_dsn, LPDWORD usage_
             size = sizeof(usagecount);
             RegGetValueA(hkeydriver, NULL, "UsageCount", RRF_RT_DWORD, &type, &usagecount, &size);
             TRACE("Usage count %ld\n", usagecount);
-            count = usagecount - 1;
+            count = usagecount ? usagecount - 1 : 0;
             if (count)
             {
                  if (RegSetValueExA(hkeydriver, "UsageCount", 0, REG_DWORD, (BYTE*)&count, sizeof(count)) != ERROR_SUCCESS)
@@ -2265,7 +2265,7 @@ BOOL WINAPI SQLRemoveTranslatorW(const WCHAR *translator, DWORD *usage_count)
             size = sizeof(usagecount);
             RegGetValueA(hkeydriver, NULL, "UsageCount", RRF_RT_DWORD, &type, &usagecount, &size);
             TRACE("Usage count %ld\n", usagecount);
-            count = usagecount - 1;
+            count = usagecount ? usagecount - 1 : 0;
             if (count)
             {
                  if (RegSetValueExA(hkeydriver, "UsageCount", 0, REG_DWORD, (BYTE*)&count, sizeof(count)) != ERROR_SUCCESS)
-- 
2.53.0

