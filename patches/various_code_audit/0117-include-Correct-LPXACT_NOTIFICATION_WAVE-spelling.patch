     IXACT3Wave *pWave;
 } XACT_NOTIFICATION_WAVE, *LPXACT_NOTIFICATION_WAVE;
-typedef const XACT_NOTIFICATION_WAVE *LPCXACT_NOTIFICATION_NAME;
