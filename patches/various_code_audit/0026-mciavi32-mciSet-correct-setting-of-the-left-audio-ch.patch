From 89aa86a118187d5eb3d2aab4fcf9ee4256de6b4c Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 17 Sep 2026 11:32:16 +1000
Subject: [PATCH] mciavi32: mciSet correct setting of the left audio channel

---
 dlls/mciavi32/info.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/mciavi32/info.c b/dlls/mciavi32/info.c
index 286753f6487..2eb3320ea62 100644
--- a/dlls/mciavi32/info.c
+++ b/dlls/mciavi32/info.c
@@ -311,7 +311,7 @@ DWORD	MCIAVI_mciSet(UINT wDevID, DWORD dwFlags, LPMCI_DGV_SET_PARMS lpParms)
 		break;
 	    case MCI_SET_AUDIO_LEFT:
 		szAudio = " audio left";
-		wma->dwSet &= ~2;
+		wma->dwSet &= ~1;
 		break;
 	    case MCI_SET_AUDIO_RIGHT:
 		szAudio = " audio right";
-- 
2.53.0

