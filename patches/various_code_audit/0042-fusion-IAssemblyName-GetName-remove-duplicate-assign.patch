From 092e4b8630ddb3ba3282abd1f93bef73947a086a Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 24 Sep 2026 10:39:18 +1000
Subject: [PATCH] fusion: IAssemblyName::GetName remove duplicate assignment.

---
 dlls/fusion/asmname.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/fusion/asmname.c b/dlls/fusion/asmname.c
index 4169330adf7..5d703740ffa 100644
--- a/dlls/fusion/asmname.c
+++ b/dlls/fusion/asmname.c
@@ -398,8 +398,8 @@ static HRESULT WINAPI IAssemblyNameImpl_GetName(IAssemblyName *iface,
         *lpcwBuffer = len;
         return E_NOT_SUFFICIENT_BUFFER;
     }
-    if (!name->name) lpcwBuffer[0] = 0;
-    else lstrcpyW(pwzName, name->name);
+    if (name->name)
+        lstrcpyW(pwzName, name->name);
 
     *lpcwBuffer = len;
     return S_OK;
-- 
2.53.0

