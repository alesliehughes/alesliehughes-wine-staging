From f05f51c3e7996fd697a5c1591fe6e506ebb03aa6 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 17 Sep 2026 11:21:41 +1000
Subject: [PATCH] sapi: ISpVoice::Speak handle memory allocation failure

---
 dlls/sapi/tts.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/dlls/sapi/tts.c b/dlls/sapi/tts.c
index 11de8a7b2fa..6f575c79a73 100644
--- a/dlls/sapi/tts.c
+++ b/dlls/sapi/tts.c
@@ -1158,7 +1158,11 @@ static HRESULT WINAPI spvoice_Speak(ISpVoice *iface, const WCHAR *contents, DWOR
         goto fail;
     }
 
-    speak_task = malloc(sizeof(*speak_task));
+    if (!(speak_task = malloc(sizeof(*speak_task))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto fail;
+    }
 
     speak_task->task.proc = speak_proc;
     speak_task->result    = NULL;
-- 
2.53.0

