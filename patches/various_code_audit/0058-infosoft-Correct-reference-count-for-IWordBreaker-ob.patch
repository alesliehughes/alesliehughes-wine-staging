From e0c5a43915a9a79e7f00bdcfaffe4e1ee62bcff1 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Mon, 12 Oct 2026 21:33:59 +1100
Subject: [PATCH] infosoft: Correct reference count for IWordBreaker object.

---
 dlls/infosoft/wordbreaker.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/dlls/infosoft/wordbreaker.c b/dlls/infosoft/wordbreaker.c
index 1946bdc6c47..ecceed13cab 100644
--- a/dlls/infosoft/wordbreaker.c
+++ b/dlls/infosoft/wordbreaker.c
@@ -58,9 +58,14 @@ static HRESULT WINAPI wb_QueryInterface( IWordBreaker *iface,
         *ppvObj = &This->IWordBreaker_iface;
         return S_OK;
     }
+    else
+    {
+        FIXME( "interface %s not implemented\n", debugstr_guid(riid) );
+        return E_NOINTERFACE;
+    }
 
-    TRACE("-- E_NOINTERFACE\n");
-    return E_NOINTERFACE;
+    IWordBreaker_AddRef( iface );
+    return S_OK;
 }
 
 static ULONG WINAPI wb_AddRef( IWordBreaker *iface )
@@ -185,6 +190,7 @@ HRESULT WINAPI wb_Constructor(IUnknown* pUnkOuter, REFIID riid, LPVOID *ppvObjec
 {
     wordbreaker_impl *This;
     IWordBreaker *wb;
+    HRESULT hr;
 
     TRACE("%p %s %p\n", pUnkOuter, debugstr_guid(riid), ppvObject);
 
@@ -197,5 +203,8 @@ HRESULT WINAPI wb_Constructor(IUnknown* pUnkOuter, REFIID riid, LPVOID *ppvObjec
 
     wb = &This->IWordBreaker_iface;
 
-    return IWordBreaker_QueryInterface(wb, riid, ppvObject);
+    hr = IWordBreaker_QueryInterface(&This->IWordBreaker_iface, riid, ppvObject);
+    IWordBreaker_Release(&This->IWordBreaker_iface);
+
+    return hr;
 }
-- 
