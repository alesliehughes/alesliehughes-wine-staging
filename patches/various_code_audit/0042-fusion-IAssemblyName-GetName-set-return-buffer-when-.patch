From 3c110068078262056eee6573425064b26e652b05 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 24 Sep 2026 10:39:18 +1000
Subject: [PATCH] fusion: IAssemblyName::GetName set return buffer when name is
 empty

---
 dlls/fusion/asmname.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/fusion/asmname.c b/dlls/fusion/asmname.c
index 4169330adf7..e443b2ffa90 100644
--- a/dlls/fusion/asmname.c
+++ b/dlls/fusion/asmname.c
@@ -398,7 +398,7 @@ static HRESULT WINAPI IAssemblyNameImpl_GetName(IAssemblyName *iface,
         *lpcwBuffer = len;
         return E_NOT_SUFFICIENT_BUFFER;
     }
-    if (!name->name) lpcwBuffer[0] = 0;
+    if (!name->name) pwzName[0] = 0;
     else lstrcpyW(pwzName, name->name);
 
     *lpcwBuffer = len;
-- 
2.53.0

