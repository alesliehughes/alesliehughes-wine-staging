From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Fri, 23 Oct 2026 07:17:50 +1100
Subject: [PATCH] comsvcs: create_holder - AddRef for the driver reference

---
 dlls/comsvcs/main.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/comsvcs/main.c b/dlls/comsvcs/main.c
index 5a5ac8ea3a5..34c813ab0a5 100644
--- a/dlls/comsvcs/main.c
+++ b/dlls/comsvcs/main.c
@@ -387,6 +387,7 @@ static HRESULT create_holder(IDispenserManager *manager, IDispenserDriver *drive
     (*hold)->manager = manager;
     IDispenserManager_AddRef(manager);
     (*hold)->driver = driver;
+    IDispenserDriver_AddRef(driver);
     list_init(&(*hold)->pool);
     return S_OK;
 }
