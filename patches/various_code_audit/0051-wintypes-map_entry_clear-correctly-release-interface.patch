From 2c88282f4c3503416c7db6c7c19eb006f91c6471 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Mon, 12 Oct 2026 09:08:28 +1100
Subject: [PATCH] wintypes: map_entry_clear correctly release interface

---
 dlls/wintypes/map.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dlls/wintypes/map.c b/dlls/wintypes/map.c
index 11280d968a7..c9ff2516655 100644
--- a/dlls/wintypes/map.c
+++ b/dlls/wintypes/map.c
@@ -49,7 +49,7 @@ static void map_entry_clear( struct map_entry *entry )
 {
     WindowsDeleteString( entry->key );
     entry->key = NULL;
-    IInspectable_AddRef( entry->value );
+    IInspectable_Release( entry->value );
     entry->value = NULL;
 }
 
