From 77fe1913675ee7c0f25bafbe98007bf8b916a276 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Mon, 12 Oct 2026 21:11:36 +1100
Subject: [PATCH] hnetcfg: Only assign output on success in NetFwPolicy2_create

---
 dlls/hnetcfg/policy.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/hnetcfg/policy.c b/dlls/hnetcfg/policy.c
index b5306e84c53..4a02c83e308 100644
--- a/dlls/hnetcfg/policy.c
+++ b/dlls/hnetcfg/policy.c
@@ -1447,14 +1447,14 @@ HRESULT NetFwPolicy2_create( IUnknown *outer, void **obj )
     fp->INetFwPolicy2_iface.lpVtbl = &fw_policy2_vtbl;
     fp->refs = 1;
 
-    *obj = &fp->INetFwPolicy2_iface;
-
     if (FAILED(create_INetFwRules(&fp->fw_policy2_rules)))
     {
         free( fp );
         return E_OUTOFMEMORY;
     }
 
+    *obj = &fp->INetFwPolicy2_iface;
+
     TRACE("returning iface %p\n", *obj);
     return S_OK;
 }
-- 
2.53.0

