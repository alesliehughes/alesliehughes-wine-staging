From bdd5f24bd27afc421fef8fd1b73c8ce80e500d61 Mon Sep 17 00:00:00 2001
From: Alistair Leslie-Hughes <leslie_alistair@hotmail.com>
Date: Thu, 22 Oct 2026 11:01:00 +1100
Subject: [PATCH] include: Correct HID_USAGE_LED_GENERIC_INDICATOR value

---
 include/hidusage.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/hidusage.h b/include/hidusage.h
index 58ae5aab3e6..ec0a618a6ac 100644
--- a/include/hidusage.h
+++ b/include/hidusage.h
@@ -183,7 +183,7 @@ typedef USHORT USAGE, *PUSAGE;
 #define HID_USAGE_LED_RED                       ((USAGE) 0x48)
 #define HID_USAGE_LED_GREEN                     ((USAGE) 0x49)
 #define HID_USAGE_LED_AMBER                     ((USAGE) 0x4A)
-#define HID_USAGE_LED_GENERIC_INDICATOR         ((USAGE) 0x3B)
+#define HID_USAGE_LED_GENERIC_INDICATOR         ((USAGE) 0x4B)
 
 #define HID_USAGE_PAGE_UNDEFINED          ((USAGE) 0x00)
 #define HID_USAGE_PAGE_GENERIC            ((USAGE) 0x01)
-- 
2.53.0

